#!/bin/zsh

echo "# Test script: $0"
echo

echo "\`\`\`"
cat -n "$0"
echo "\`\`\`"

echo

script_dir="${0:A:h}"
datasets="$script_dir/../50k_data"

if (( $# != 1 )); then
  echo "Usage: $0 INPUT_FILENAME" >&2
  exit 2
fi

input_file="$datasets/$1"
input_name="${1:t}"
input_stem="${input_name:r}"
report_root="$script_dir/testrpts"
report_dir="$report_root/$input_stem"
archive_root="$report_root/archive"

if [[ ! -d "$datasets" ]]; then
  echo "Input directory does not exist: $datasets" >&2
  exit 1
fi

if [[ ! -f "$input_file" ]]; then
  echo "Input file does not exist: $input_file" >&2
  exit 1
fi

if [[ -z "$input_stem" || "$input_stem" == "." || "$input_stem" == ".." ]]; then
  echo "Refusing to archive an invalid report directory for input: $1" >&2
  exit 2
fi

if [[ -d "$report_dir" ]]; then
  report_timestamp=$(stat -f '%Sm' -t '%Y-%m-%d_%H-%M-%S' "$report_dir") || exit 1
  archive_dir="$archive_root/$input_stem.$report_timestamp"

  if [[ -e "$archive_dir" ]]; then
    echo "Refusing to overwrite existing report archive: $archive_dir" >&2
    exit 1
  fi

  mkdir -p -- "$archive_root"
  echo "Archiving previous test artifacts to: $archive_dir"
  mv -- "$report_dir" "$archive_dir"
fi

# Recreating the directory gives it a fresh modification timestamp.
mkdir -p -- "$report_dir"

python_bin="$script_dir/.venv/bin/python"
[[ -x "$python_bin" ]] || python_bin="${commands[python3]:-python3}"

"$python_bin" "$script_dir/scripts/run-all-f32-compression-tests.py" \
  -i "$input_file" \
  -tsweep 0.01:10.0:count=10 \
  -g 20 \
  -bsweep 256:2048:count=4 -bscale="geometric"
