#!/bin/zsh
setopt NULL_GLOB

if (( $# != 1 )); then
    print -u2 "Usage: $0 <input-filename-or-stem>"
    exit 2
fi

script_dir="${0:A:h}"
plot="$script_dir/scripts/csvplot"
input_stem="${${1:t}:r}"
input_csv=("$script_dir"/testrpts/"$input_stem"/"$input_stem"*.csv)

if (( ${#input_csv} == 0 )); then
    print -u2 "No CSV reports found in $script_dir/testrpts/$input_stem"
    exit 1
fi

"$plot" -i "${input_csv[@]}" --xcol eps --ycols CR --single-plot &
"$plot" -i "${input_csv[@]}" --xcol eps --ycols MaxAbsErr --single-plot &
"$plot" -i "${input_csv[@]}" --xcol eps --ycols valid.samples --single-plot &
"$plot" -i "${input_csv[@]}" -lx --xcol CR --ycols PSNR.dB --single-plot --scatterplot &
wait
