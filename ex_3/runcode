#!/bin/zsh
setopt NULL_GLOB

# --------------------------------------
# optional g++ cmd line parameters
# -fno-exceptions -fno-rtti -pedantic -Werror -Wno-unused-function -Wno-unused-variable -Wno-unused-parameter
# --------------------------------------

mkdir -p ./testrpts

if (( $# != 2 )); then
    print -u2 "Usage: $0 <executable-name> <input-file.f32>"
    exit 2
fi

output_file="$1"
input_file="$2"
if [[ "$input_file" != */* ]]; then
    input_file="../50k_data/$input_file"
fi

if [[ ! -f "$input_file" ]]; then
    print -u2 "Input file not found: $input_file"
    exit 2
fi

output_path="${output_file:A}"
input_path="${input_file:A}"

if [[ "$output_path" == "$input_path" ]] ||
   { [[ -e "$output_file" ]] && [[ "$output_file" -ef "$input_file" ]]; }; then
    print -u2 "Refusing to overwrite input file: $input_file"
    exit 2
fi

if [[ "${output_file:e}" == "f32" ]]; then
    print -u2 "Refusing executable name with .f32 extension: $output_file"
    exit 2
fi

# Use only the input filename stem for generated report names.
input_name="${${input_file:t}:r}"
report_file="./testrpts/${input_name}-runcode.md"

# CMake is the shared build definition for CLion and this runner.
project_root="${0:A:h:h}"
preset="${SR_BUILD_PRESET:-asan}"
if sh "$project_root/scripts/build-experiment.sh" "$preset" ex3_exprgen; then
    # Keep the requested executable path for existing batch/plotting scripts.
    cp "$project_root/build/$preset/bin/ex3_exprgen" "$output_path" || exit 1
    rm -f -- "$report_file"

    export GPP_VERSION="CMake preset: $preset (see build/$preset/CMakeCache.txt for compiler)"
    echo "$GPP_VERSION"
    "$output_path" -b 250 -g 100 -n 1000 -i "$input_file" &>"$report_file"
else
    exit 1
fi
